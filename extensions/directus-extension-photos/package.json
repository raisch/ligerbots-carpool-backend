{
  "name": "directus-extension-photos",
  "description": "Please enter a description for your extension",
  "icon": "extension",
  "version": "1.0.0",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-endpoint"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "directus:extension": {
    "type": "endpoint",
    "path": "dist/index.js",
    "source": "src/index.js",
    "host": "^10.10.0"
  },
  "config": {
    "remote": {
      "host": "ligerbots.4msg.net",
      "username": "root",
      "path": "/opt/etc/tmp/extensions"
    }
  },
  "scripts": {
    "env": "env",
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "-----------": "echo 'This is a placeholder for the following commands'",
    "pkg:clean": "echo cleaning package && rm -f ../${npm_package_name}.tgz",
    "pkg:make": "echo making package && tar czf ../${npm_package_name}.tgz ../${npm_package_name}/package.json ../${npm_package_name}/dist",
    "pkg:upload": "echo uploading package && npm run pkg:scp",
    "pkg:scp": "scp ../${npm_package_name}.tgz ${npm_package_config_remote_username}@${npm_package_config_remote_host}:${npm_package_config_remote_path}",
    "pkg": "npm run build && npm run pkg:clean && npm run pkg:make && npm run pkg:upload"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "12.0.2"
  }
}
